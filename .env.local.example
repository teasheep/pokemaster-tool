# === Supabase ===
# 在 https://supabase.com 建立一個新專案後, 從 Settings > API 取得
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# 直連資料庫 (migrations / 匯入腳本用) — 從 Database 設定取得連線字串
DATABASE_URL=postgresql://...

# === Site URL (用於 auth 回呼) ===
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# 截圖辨識 (重 ML 依賴) — 只在本機開發啟用; 線上部署不要設, /upload 與相關 API 會整組隱藏
# NEXT_PUBLIC_ENABLE_RECOGNITION=1
